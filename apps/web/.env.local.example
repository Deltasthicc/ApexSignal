# mock_server (port 8000) needs no other service running -- fastest local loop.
# Swap to http://localhost:8001 to point at the real services/core_api instead
# (run it with EVALUATE_MODE=fixture for the same demo data with zero other deps).
NEXT_PUBLIC_CORE_API_BASE_URL=http://localhost:8000

# Only needed if radio analysis is served from a different origin than
# NEXT_PUBLIC_CORE_API_BASE_URL above (e.g. the real radio_ai container on
# its own port). Defaults to NEXT_PUBLIC_CORE_API_BASE_URL when unset.
# NEXT_PUBLIC_RADIO_AI_BASE_URL=http://localhost:8002

# "embedded" forces the built-in fixture fallback even with a base URL set
# above; leave unset for normal remote-API behavior.
# NEXT_PUBLIC_DATA_MODE=embedded
