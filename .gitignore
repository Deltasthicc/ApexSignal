# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo
apps/web/.env*.local

# Env files
.env
*.env
!.env.example

# Data and model artifacts (large, regenerated by data_pipeline)
data/audio/*
!data/audio/.gitkeep
data/telemetry/*
!data/telemetry/.gitkeep
# radio_ai live-pipeline output -- placeholder-incident-id runs before
# Jagrav's incident_manifest.json exists shouldn't get committed by
# accident. One dated snapshot with an explanatory README was committed
# deliberately on 2026-08-12; this rule only affects new/future files.
data/radio_analysis/*
!data/radio_analysis/README.md
*.parquet
*.wav
*.mp3
!contracts/fixtures/**
# apps/web ships its own small, deliberately-committed static assets
# (hero clip etc.) -- distinct from the regenerated data/ audio corpus
# the *.mp3 rule above is for.
!apps/web/public/audio/**

# Model caches
.cache/
models/
*.faiss
*.index

# SQLite
storage/*.db
storage/*.sqlite3

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
