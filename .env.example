# Copy to .env in the relevant service directory. Never commit the real file.

# Hugging Face
HF_TOKEN=your_hugging_face_token_here
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Model IDs/revisions for ASR and tone are pinned in
# services/radio_ai/app/config.py (ASR_MODEL_ID, TONE_ENCODER_ID, etc.)
# and overridden via services/radio_ai/.env, not this root file -- no
# HF_ASR_MODEL / HF_TONE_MODEL variable is read anywhere in the code.

# services/radio_ai
RADIO_AI_PORT=8002

# services/core_api
CORE_API_PORT=8001
CORE_API_DB_PATH=./storage/incidents.db
# core_api reads radio_ai's output from disk (CORE_API_RADIO_ANALYSIS_DIR,
# defaulting to data/radio_analysis/), never over HTTP -- there is no
# radio_ai base URL to configure here.

# mock_server (port is passed as a uvicorn CLI arg, not read from env)
# STATIC_SITE_DIR=../apps/web/out   # optional: serve a static web export

# apps/web
NEXT_PUBLIC_CORE_API_BASE_URL=http://localhost:8001
