RADIO_AI_PORT=8002

# Read-scoped Hugging Face token. None of the pinned models/datasets
# below are gated, so this isn't strictly required for downloads, but
# set it anyway -- avoids anonymous rate limits and is needed if any
# model swaps to a gated one later. Use a fine-grained READ token, not
# your write token (https://huggingface.co/settings/tokens). Never
# commit the real value.
HF_TOKEN=your_hugging_face_read_token_here

# fixture | live. fixture returns contracts/fixtures/radio_analysis_output.sample.json
# unchanged. live runs the real ASR -> tone -> classifier pipeline and
# requires the model dependencies in requirements.txt to be installed.
ANALYZE_MODE=fixture

# --- Model IDs + pinned revisions -----------------------------------
# Verified against the live HF Hub API on 2026-08-11: exist, ungated,
# license as documented in README.md. Don't bump a revision without
# re-running VALIDATION_GATES.md against the new weights.
ASR_MODEL_ID=distil-whisper/distil-large-v3.5-ct2
ASR_MODEL_REVISION=9793ccc07920e0f830e1dba0343efcdf0ef8c903
ASR_FALLBACK_MODEL_ID=Systran/faster-whisper-small.en
ASR_FALLBACK_MODEL_REVISION=d1d751a5f8271d482d14ca55d9e2deeebbae577f
USE_ASR_FALLBACK=false

TONE_ENCODER_ID=laion/voiceclap-commercial
TONE_ENCODER_REVISION=c291e8b13f3bd06e2c917d389133ffabccd53b70
TONE_HEADS_ID=laion/voiceclap-commercial-attribute-heads
TONE_HEADS_REVISION=8441fbd4050fb670c34453d99b3fdae7e8513667

CLASSIFIER_MODEL_ID=MoritzLaurer/deberta-v3-base-zeroshot-v1.1-all-33
CLASSIFIER_MODEL_REVISION=613e8c52c33e2bc0677ada4ad760f693e5e0f581
CLASSIFIER_FALLBACK_MODEL_ID=MoritzLaurer/deberta-v3-xsmall-zeroshot-v1.1-all-33
CLASSIFIER_FALLBACK_MODEL_REVISION=262ae02f29173eec1c250f90804dc7edc677dcff
USE_CLASSIFIER_FALLBACK=false

DEV_DATASET_ID=MikCil/f1-team-radio
DEV_DATASET_REVISION=a0b99e1a325d92d63b574541a24902a660a352ea

# NEEDS_CALIBRATION -- see VALIDATION_GATES.md before trusting these
AROUSAL_ELEVATED_THRESHOLD=0.6
FATIGUE_THRESHOLD=0.7
LOW_QUALITY_NOISE_FLOOR=0.3
CLASSIFIER_NULL_THRESHOLD=0.5

# Stays false until VALIDATION_GATES.md gate 5 passes.
ENABLE_TEXT_TONE_DISAGREEMENT=false
