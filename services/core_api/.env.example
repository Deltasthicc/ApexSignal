CORE_API_PORT=8001
CORE_API_DB_PATH=../../storage/incidents.db
RADIO_AI_BASE_URL=http://localhost:8002
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# fixture | live. fixture serves contracts/fixtures/incident_assessment.sample.json.
EVALUATE_MODE=fixture

# --- inputs the live pipeline reads (relative paths resolve from repo root) ---

# Workstream A: the incident manifest, loaded into SQLite by `python -m app.ingest`.
CORE_API_MANIFEST_PATH=data/incident_manifest.json

# Workstream B: one {incident_id}.json per incident, each matching
# contracts/schemas/radio_analysis_output.schema.json. Read from disk rather
# than over HTTP so core_api evaluates with no other service running.
# NOTE: where Workstream B actually writes these is not yet agreed --
# see services/core_api/PROGRESS_REPORT.md.
CORE_API_RADIO_ANALYSIS_DIR=data/radio_analysis

# Root that the manifest's telemetry_window_path values resolve against.
CORE_API_TELEMETRY_ROOT=.
