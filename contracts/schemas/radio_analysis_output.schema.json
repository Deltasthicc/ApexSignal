{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RadioAnalysisOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident_id",
    "transcript",
    "tone_label",
    "tone_score",
    "tone_confidence"
  ],
  "properties": {
    "incident_id": { "type": "string" },
    "transcript": { "type": "string" },
    "tone_label": {
      "type": "string",
      "enum": ["CALM", "ELEVATED_AROUSAL", "FATIGUED"]
    },
    "tone_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "tone_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "complaint_category": {
      "type": ["string", "null"],
      "enum": [
        "EXIT_TRACTION_REAR",
        "FRONT_TURNIN_BRAKE",
        "TYRE_GRIP_DEGRADATION",
        "VISIBILITY_TRACK_CONDITION",
        "MECHANICAL_OTHER",
        null
      ]
    },
    "category_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "text_tone_disagreement": {
      "type": "string",
      "enum": ["LOW", "MODERATE", "HIGH"]
    }
  }
}
